# One file per agent. This file is read by ./agent and is never mounted.

AGENT_ID=gradients-unmasked

# One Slack app and one channel for this agent.
SLACK_BOT_TOKEN=xoxb-REPLACE
SLACK_APP_TOKEN=xapp-REPLACE
SLACK_CHANNEL_ID=C_REPLACE
SLACK_ALLOWED_USER_ID=U_REPLACE

# Expendable fine-grained token, limited to this agent's output repository.
GITHUB_PAT=github_pat_REPLACE
GITHUB_REPOSITORY=owner/repository

# Default for direct runs. An exported value or AGENT_GPU=... ./agent run overrides it.
AGENT_GPU=none

# Optional. Use only when the network inserts a private certificate authority.
# AGENT_CA_BUNDLE=/absolute/path/to/organisation-ca.pem

# Optional. Normally derived from AGENT_ID.
# AGENT_GATEWAY_PORT=18789
# AGENT_WORKER_PORT=22789
