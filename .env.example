# Per-project runtime config.
# Copy to .env, fill in, and chmod 600 .env. .env is gitignored; never commit.

# Short stable id for this project instance. Used for default directory names.
CLANKENSTEIN_ID=replace-me

# Slack app tokens for this project. Use one Slack app per Clankenstein.
SLACK_BOT_TOKEN=xoxb-REPLACE
SLACK_APP_TOKEN=xapp-REPLACE

# Slack channel for this project. Use the channel id, not the channel name.
SLACK_CHANNEL_ID=C_REPLACE
SLACK_CHANNEL_NAME=dr-clankenstein-replace-me
SLACK_ALLOWED_USER_ID=U0B364S9A01

# Random token for the local OpenClaw gateway auth. Generate with:
#   openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=REPLACE_WITH_RANDOM_HEX

# Research output repository for this project.
# The token must be able to read and write this repo.
RUNS_REPO_URL=https://github.com/prebenness/replace-me-runs.git
GITHUB_PAT=github_pat_REPLACE

# Per-project host paths on EX3. Keep these unique per project.
CLANKENSTEIN_WORKSPACE_DIR=/home/prebenmn/D1/agent-workspaces/replace-me
CLANKENSTEIN_OPENCLAW_DIR=/home/prebenmn/D1/openclaw-state/replace-me

# Must be unique if two agents may land on the same node.
CLANKENSTEIN_GATEWAY_PORT=18790

# Shared container image.
CLANKENSTEIN_IMAGE=/home/prebenmn/D1/containers/agent.sif
