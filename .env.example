# Local secrets for docker-run.sh.
# Copy to .env and fill in. .env is gitignored; never commit.

# Slack tokens from your app at https://api.slack.com/apps -> Dr Clankenstein
SLACK_BOT_TOKEN=xoxb-REPLACE
SLACK_APP_TOKEN=xapp-REPLACE

# Random token for OpenClaw gateway auth. Generate with:
#   openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=REPLACE_WITH_RANDOM_HEX

# Fine-grained PAT scoped only to dr-clankenstein-runs.
# Permissions: Contents read+write, Metadata read.
GITHUB_PAT=github_pat_REPLACE
