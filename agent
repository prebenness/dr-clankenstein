#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
LOCAL="$ROOT/.agent"
IMAGES_DIR="$LOCAL/images"
LEGACY_IMAGE="$LOCAL/runtime.sif"
LEGACY_IMAGE_REF_FILE="$LOCAL/image.ref"
STATE="$LOCAL/gateway-state"
WORKSPACE="$LOCAL/workspace"
BOOTSTRAP="$LOCAL/bootstrap"
BRIDGE="$LOCAL/bridge"
GATEWAY_BRIDGE="$BRIDGE/gateway"
WORKER_BRIDGE="$BRIDGE/worker"
RUN_DIR="$LOCAL/run"
LOG_DIR="$LOCAL/logs"
ENV_FILE="${AGENT_ENV_FILE:-$ROOT/.env}"
LOCK_FILE="$ROOT/image.lock"
REGISTRY_AUTH_FILE="${AGENT_REGISTRY_AUTH_FILE:-$HOME/.apptainer/agent-registry-auth.json}"
HOST_SENTINEL="$RUN_DIR/host-only-sentinel"
RESOLV_CONF="$RUN_DIR/resolv.conf"
PROCESS_LOCK="$LOCAL/process.lock"
PLUGIN_LINK_STATE="$STATE/.agent-plugin-links-image-ref"
WSL_CUDA_LIB_DIR=/usr/local/cuda/targets/x86_64-linux/lib

IMAGE=
IMAGE_REF_FILE=
IMAGE_REF=
IMAGE_ARCH=
IMAGE_VARIANT=
WORKER_PID=
GATEWAY_PID=
WORKER_ENV=
GATEWAY_ENV=
HOST_ENV_FILE=
HOST_PRIVATE_FILE=

die() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: ./agent COMMAND

Commands:
  pull [VARIANT|all]
             Pull the selected image, one named variant, or every variant.
             Variants: cuda-amd64, cuda-arm64, rocm-amd64.
  auth       Sign in to Codex inside the gateway box.
  validate   Validate configuration, authentication, plugins, and isolation.
  run        Run the worker and Slack gateway in the foreground.
EOF
}

need_command() {
    command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

acquire_process_lock() {
    need_command flock
    mkdir -p "$LOCAL"
    exec 9>"$PROCESS_LOCK"
    flock -n 9 || die "another ./agent command is already using $ROOT"
}

load_optional_env() {
    local name
    local -A overrides=()

    # Explicit launch and Slurm settings take precedence over .env defaults.
    for name in AGENT_GPU AGENT_IMAGE_VARIANT AGENT_GATEWAY_PORT AGENT_WORKER_PORT AGENT_CA_BUNDLE; do
        [[ -v "$name" ]] && overrides["$name"]="${!name}"
    done

    if [[ -f "$ENV_FILE" ]]; then
        set -a
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set +a
    fi

    for name in "${!overrides[@]}"; do
        printf -v "$name" '%s' "${overrides[$name]}"
    done
}

require_value() {
    local name="$1"
    [[ -n "${!name:-}" ]] || die "$name is required in $ENV_FILE"
    [[ "${!name}" != *$'\n'* ]] || die "$name must be one line"
}

load_env() {
    [[ -f "$ENV_FILE" ]] || die "missing $ENV_FILE; create it from .env.example"
    load_optional_env

    require_value AGENT_ID
    require_value SLACK_BOT_TOKEN
    require_value SLACK_APP_TOKEN
    require_value SLACK_CHANNEL_ID
    require_value SLACK_ALLOWED_USER_ID
    require_value GITHUB_PAT

    [[ "$AGENT_ID" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] ||
        die 'AGENT_ID must contain 1-32 lower-case letters, digits, or hyphens'
    [[ "$SLACK_CHANNEL_ID" =~ ^[A-Z0-9]+$ ]] || die 'SLACK_CHANNEL_ID is not valid'
    [[ "$SLACK_ALLOWED_USER_ID" =~ ^[A-Z0-9]+$ ]] || die 'SLACK_ALLOWED_USER_ID is not valid'
    if [[ -n "${GITHUB_REPOSITORY:-}" ]]; then
        [[ "$GITHUB_REPOSITORY" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] ||
            die 'GITHUB_REPOSITORY must have the form owner/repository'
    fi
}

load_lock() {
    [[ -f "$LOCK_FILE" ]] || die "missing $LOCK_FILE"
    # shellcheck disable=SC1090
    source "$LOCK_FILE"

    # Accept the original lock during the transition to the three-image lock.
    IMAGE_CUDA_AMD64_REF="${IMAGE_CUDA_AMD64_REF:-${IMAGE_REF:-}}"
    IMAGE_CUDA_ARM64_REF="${IMAGE_CUDA_ARM64_REF:-}"
    IMAGE_ROCM_AMD64_REF="${IMAGE_ROCM_AMD64_REF:-}"

    [[ "$IMAGE_CUDA_AMD64_REF" =~ ^docker://ghcr\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]] ||
        die 'image.lock does not contain the immutable cuda-amd64 image reference'
    for IMAGE_REF in "$IMAGE_CUDA_ARM64_REF" "$IMAGE_ROCM_AMD64_REF"; do
        [[ -z "$IMAGE_REF" || "$IMAGE_REF" =~ ^docker://ghcr\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]] ||
            die 'image.lock contains an invalid immutable image reference'
    done
    IMAGE_REF=
}

normalize_arch() {
    case "$1" in
        x86_64|amd64) printf 'amd64\n' ;;
        aarch64|arm64) printf 'arm64\n' ;;
        *) die "unsupported host architecture: $1" ;;
    esac
}

select_image() {
    local requested="${1:-}"
    local purpose="${2:-runtime}"
    local host_arch

    if [[ -z "$requested" ]]; then
        requested="${AGENT_IMAGE_VARIANT:-}"
    fi
    if [[ -z "$requested" ]]; then
        host_arch="$(normalize_arch "$(uname -m)")"
        if [[ "${AGENT_GPU:-none}" == rocm ]]; then
            requested=rocm-amd64
        else
            requested="cuda-$host_arch"
        fi
    fi

    case "$requested" in
        cuda-amd64)
            IMAGE_REF="$IMAGE_CUDA_AMD64_REF"
            IMAGE_ARCH=amd64
            ;;
        cuda-arm64)
            IMAGE_REF="$IMAGE_CUDA_ARM64_REF"
            IMAGE_ARCH=arm64
            ;;
        rocm-amd64)
            IMAGE_REF="$IMAGE_ROCM_AMD64_REF"
            IMAGE_ARCH=amd64
            ;;
        *)
            die "unknown image variant: $requested"
            ;;
    esac
    [[ -n "$IMAGE_REF" ]] || die "image variant $requested has not been published in image.lock"

    IMAGE_VARIANT="$requested"
    IMAGE="$IMAGES_DIR/$IMAGE_VARIANT.sif"
    IMAGE_REF_FILE="$IMAGES_DIR/$IMAGE_VARIANT.ref"

    if [[ "$purpose" == runtime ]]; then
        host_arch="$(normalize_arch "$(uname -m)")"
        [[ "$host_arch" == "$IMAGE_ARCH" ]] ||
            die "image variant $IMAGE_VARIANT cannot run on host architecture $host_arch"
        case "$IMAGE_VARIANT:${AGENT_GPU:-none}" in
            cuda-*:none|cuda-*:nv|rocm-amd64:none|rocm-amd64:rocm) ;;
            *) die "image variant $IMAGE_VARIANT is incompatible with AGENT_GPU=${AGENT_GPU:-none}" ;;
        esac
    fi
}

derive_runtime() {
    local checksum
    checksum="$(printf '%s' "$AGENT_ID" | cksum)"
    checksum="${checksum%% *}"

    AGENT_WORKER_PORT="${AGENT_WORKER_PORT:-$((22000 + checksum % 1000))}"
    AGENT_GATEWAY_PORT="${AGENT_GATEWAY_PORT:-$((18000 + checksum % 1000))}"
    AGENT_GPU="${AGENT_GPU:-none}"
    [[ "$AGENT_WORKER_PORT" =~ ^[0-9]+$ ]] || die 'AGENT_WORKER_PORT must be an integer'
    [[ "$AGENT_GATEWAY_PORT" =~ ^[0-9]+$ ]] || die 'AGENT_GATEWAY_PORT must be an integer'
    ((AGENT_WORKER_PORT >= 1024 && AGENT_WORKER_PORT <= 65535)) || die 'AGENT_WORKER_PORT is out of range'
    ((AGENT_GATEWAY_PORT >= 1024 && AGENT_GATEWAY_PORT <= 65535)) || die 'AGENT_GATEWAY_PORT is out of range'
    [[ "$AGENT_WORKER_PORT" != "$AGENT_GATEWAY_PORT" ]] || die 'gateway and worker ports must differ'
    [[ "$AGENT_GPU" == none || "$AGENT_GPU" == nv || "$AGENT_GPU" == rocm ]] ||
        die 'AGENT_GPU must be none, nv, or rocm'
}

port_is_open() {
    local port="$1"
    (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null
}

is_wsl() {
    grep -qi microsoft /proc/sys/kernel/osrelease
}

require_free_ports() {
    port_is_open "$AGENT_WORKER_PORT" &&
        die "worker port $AGENT_WORKER_PORT is already in use; stop the other agent instance"
    port_is_open "$AGENT_GATEWAY_PORT" &&
        die "gateway port $AGENT_GATEWAY_PORT is already in use; stop the other agent instance"
    return 0
}

resolve_container_identity() {
    local common=(exec --compat --cleanenv --no-mount "bind-paths,home,cwd,hostfs" --pwd /app)
    AGENT_USER="$(apptainer "${common[@]}" "$IMAGE" /usr/local/bin/agent-entrypoint login-user)"
    AGENT_LOGIN_HOME="$(apptainer "${common[@]}" "$IMAGE" /usr/local/bin/agent-entrypoint login-home)"

    [[ "$AGENT_USER" =~ ^[A-Za-z0-9._-]+$ ]] || die 'could not determine a safe container login user'
    [[ "$AGENT_LOGIN_HOME" == /* && "$AGENT_LOGIN_HOME" != *:* ]] ||
        die 'could not determine the container login home'
}

ensure_image() {
    load_lock
    select_image "" runtime
    if [[ ! -f "$IMAGE" && "$IMAGE_VARIANT" == cuda-amd64 \
        && -f "$LEGACY_IMAGE" && -f "$LEGACY_IMAGE_REF_FILE" \
        && "$(<"$LEGACY_IMAGE_REF_FILE")" == "$IMAGE_REF" ]]; then
        IMAGE="$LEGACY_IMAGE"
        IMAGE_REF_FILE="$LEGACY_IMAGE_REF_FILE"
    fi
    [[ -f "$IMAGE" ]] || die 'runtime image is missing; run ./agent pull'
    [[ -f "$IMAGE_REF_FILE" ]] || die 'runtime image provenance is missing; run ./agent pull'
    [[ "$(<"$IMAGE_REF_FILE")" == "$IMAGE_REF" ]] || die 'runtime image does not match image.lock; run ./agent pull'
}

resolve_ca_bundle() {
    CA_BUNDLE=
    if [[ -n "${AGENT_CA_BUNDLE:-}" ]]; then
        [[ -f "$AGENT_CA_BUNDLE" ]] || die "AGENT_CA_BUNDLE does not exist: $AGENT_CA_BUNDLE"
        CA_BUNDLE="$(readlink -f -- "$AGENT_CA_BUNDLE")"
    fi
}

pull_one_image() {
    local variant="$1"
    local partial actual_arch host_arch

    select_image "$variant" pull
    mkdir -p "$IMAGES_DIR"
    partial="$IMAGE.partial"
    rm -f -- "$partial"
    if [[ -n "$CA_BUNDLE" ]]; then
        SSL_CERT_FILE="$CA_BUNDLE" apptainer pull --force --arch "$IMAGE_ARCH" \
            --authfile "$REGISTRY_AUTH_FILE" "$partial" "$IMAGE_REF"
    else
        apptainer pull --force --arch "$IMAGE_ARCH" \
            --authfile "$REGISTRY_AUTH_FILE" "$partial" "$IMAGE_REF"
    fi
    mv -f -- "$partial" "$IMAGE"
    printf '%s\n' "$IMAGE_REF" > "$IMAGE_REF_FILE"
    chmod 0600 "$IMAGE_REF_FILE"

    actual_arch="$(apptainer inspect "$IMAGE" | sed -n 's/^org\.label-schema\.build-arch: //p' | head -n 1)"
    [[ "$actual_arch" == "$IMAGE_ARCH" ]] ||
        die "pulled $IMAGE_VARIANT image reports architecture ${actual_arch:-unknown}, expected $IMAGE_ARCH"

    host_arch="$(normalize_arch "$(uname -m)")"
    if [[ "$host_arch" == "$IMAGE_ARCH" ]]; then
        apptainer exec --compat --cleanenv --no-mount bind-paths,home,cwd,hostfs --pwd /app \
            "$IMAGE" /usr/local/bin/agent-entrypoint check
    else
        printf 'Pulled %s for %s; execution check is deferred to a matching host.\n' \
            "$IMAGE_VARIANT" "$IMAGE_ARCH"
    fi
}

pull_image() {
    local requested="${1:-}"

    need_command apptainer
    load_optional_env
    AGENT_GPU="${AGENT_GPU:-none}"
    [[ "$AGENT_GPU" == none || "$AGENT_GPU" == nv || "$AGENT_GPU" == rocm ]] ||
        die 'AGENT_GPU must be none, nv, or rocm'
    load_lock
    resolve_ca_bundle
    [[ -f "$REGISTRY_AUTH_FILE" ]] ||
        die "registry authentication is missing: $REGISTRY_AUTH_FILE"
    mkdir -p "$LOCAL" "$IMAGES_DIR"

    if [[ "$requested" == all ]]; then
        pull_one_image cuda-amd64
        pull_one_image cuda-arm64
        pull_one_image rocm-amd64
    else
        select_image "$requested" pull
        pull_one_image "$IMAGE_VARIANT"
    fi
}

write_gateway_token() {
    local token_file="$LOCAL/gateway-token"
    if [[ ! -s "$token_file" ]]; then
        openssl rand -hex 32 > "$token_file"
        chmod 0600 "$token_file"
    fi
    OPENCLAW_GATEWAY_TOKEN="$(<"$token_file")"
}

render_config() {
    local target="$STATE/openclaw.json"
    local temporary="$RUN_DIR/openclaw.json"
    local channel_lower
    channel_lower="${SLACK_CHANNEL_ID,,}"

    sed \
        -e "s/__OPENCLAW_VERSION__/$OPENCLAW_VERSION/g" \
        -e "s/__OPENCLAW_GATEWAY_PORT__/$AGENT_GATEWAY_PORT/g" \
        -e "s/__AGENT_USER__/$AGENT_USER/g" \
        -e "s/__AGENT_WORKER_PORT__/$AGENT_WORKER_PORT/g" \
        -e "s/__SLACK_CHANNEL_ID__/$SLACK_CHANNEL_ID/g" \
        -e "s/__SLACK_CHANNEL_ID_LOWER__/$channel_lower/g" \
        -e "s/__SLACK_ALLOWED_USER_ID__/$SLACK_ALLOWED_USER_ID/g" \
        "$ROOT/openclaw.json.template" > "$temporary"
    install -m 0600 "$temporary" "$target"
}

write_instance_state() {
    local repository=null
    local temporary="$RUN_DIR/instance.json"
    if [[ -n "${GITHUB_REPOSITORY:-}" ]]; then
        repository="\"$GITHUB_REPOSITORY\""
    fi

    cat > "$temporary" <<EOF
{
  "agent_id": "$AGENT_ID",
  "slack_channel_id": "$SLACK_CHANNEL_ID",
  "persistent_workspace": "/home/node/.openclaw/workspace",
  "source_checkout": null,
  "research_output_repository": $repository
}
EOF
    install -D -m 0644 "$temporary" "$BOOTSTRAP/state/instance.json"

    if [[ -n "${SLURM_JOB_ID:-}" ]]; then
        cat > "$RUN_DIR/slurm-job.json" <<EOF
{
  "job_id": "$SLURM_JOB_ID",
  "node_list": "${SLURM_JOB_NODELIST:-unknown}",
  "time_limit": "${SLURM_TIMELIMIT:-unknown}",
  "end_time_epoch": "${SLURM_JOB_END_TIME:-unknown}"
}
EOF
        install -D -m 0644 "$RUN_DIR/slurm-job.json" "$BOOTSTRAP/state/slurm-job.json"
    else
        rm -f -- "$BOOTSTRAP/state/slurm-job.json"
    fi
}

sync_bootstrap() {
    local source destination
    shopt -s nullglob

    for source in "$ROOT"/[A-Z]*.md; do
        install -m 0644 "$source" "$BOOTSTRAP/$(basename "$source")"
    done
    [[ -f "$BOOTSTRAP/AGENTS.md" ]] || die 'AGENTS.md is missing'

    for destination in "$WORKSPACE"/openclaw-ssh-*/workspace; do
        [[ -d "$destination" ]] || continue
        cp -a "$BOOTSTRAP/." "$destination/"
    done
    shopt -u nullglob
}

generate_bridge_keys() {
    mkdir -p "$BRIDGE"
    apptainer exec --compat --cleanenv --no-mount bind-paths,home,cwd,hostfs --pwd /app \
        --bind "$BRIDGE:/bridge:rw" \
        "$IMAGE" /usr/local/bin/agent-entrypoint keygen "$AGENT_WORKER_PORT"
}

prepare() {
    need_command apptainer
    need_command openssl
    load_env
    HOST_ENV_FILE="$(readlink -f -- "$ENV_FILE")"
    if [[ -f "$REGISTRY_AUTH_FILE" ]]; then
        HOST_PRIVATE_FILE="$(readlink -f -- "$REGISTRY_AUTH_FILE")"
    else
        HOST_PRIVATE_FILE="$HOST_ENV_FILE"
    fi
    derive_runtime
    ensure_image
    resolve_ca_bundle
    resolve_container_identity

    umask 077
    mkdir -p "$STATE" "$WORKSPACE" "$BOOTSTRAP/state" "$RUN_DIR" "$LOG_DIR"
    rm -f -- "$RUN_DIR/gateway.env" "$RUN_DIR/worker.env" "$HOST_SENTINEL"
    [[ -s /etc/resolv.conf ]] || die 'host DNS resolver configuration is empty'
    install -m 0444 /etc/resolv.conf "$RESOLV_CONF"
    write_gateway_token
    render_config
    write_instance_state
    sync_bootstrap
    generate_bridge_keys
}

write_env_line() {
    local file="$1"
    local name="$2"
    local value="$3"
    [[ "$value" != *$'\n'* ]] || die "$name must be one line"
    printf '%s=%s\n' "$name" "$value" >> "$file"
}

write_gateway_env() {
    GATEWAY_ENV="$RUN_DIR/gateway.env"
    : > "$GATEWAY_ENV"
    chmod 0600 "$GATEWAY_ENV"

    write_env_line "$GATEWAY_ENV" AGENT_BOX_ROLE gateway
    write_env_line "$GATEWAY_ENV" SLACK_BOT_TOKEN "$SLACK_BOT_TOKEN"
    write_env_line "$GATEWAY_ENV" SLACK_APP_TOKEN "$SLACK_APP_TOKEN"
    write_env_line "$GATEWAY_ENV" OPENCLAW_GATEWAY_TOKEN "$OPENCLAW_GATEWAY_TOKEN"
    write_env_line "$GATEWAY_ENV" OPENCLAW_STATE_DIR /home/node/.openclaw
    write_env_line "$GATEWAY_ENV" OPENCLAW_CONFIG_PATH /home/node/.openclaw/openclaw.json
    write_env_line "$GATEWAY_ENV" OPENCLAW_DISABLE_BUNDLED_SOURCE_OVERLAYS 1

    if [[ -n "$CA_BUNDLE" ]]; then
        write_env_line "$GATEWAY_ENV" SSL_CERT_FILE /etc/ssl/certs/ca-certificates.crt
        write_env_line "$GATEWAY_ENV" NODE_EXTRA_CA_CERTS /etc/ssl/certs/ca-certificates.crt
        write_env_line "$GATEWAY_ENV" REQUESTS_CA_BUNDLE /etc/ssl/certs/ca-certificates.crt
        write_env_line "$GATEWAY_ENV" GIT_SSL_CAINFO /etc/ssl/certs/ca-certificates.crt
        write_env_line "$GATEWAY_ENV" CURL_CA_BUNDLE /etc/ssl/certs/ca-certificates.crt
    fi
}

write_worker_env() {
    WORKER_ENV="$RUN_DIR/worker.env"
    : > "$WORKER_ENV"
    chmod 0600 "$WORKER_ENV"

    write_env_line "$WORKER_ENV" AGENT_BOX_ROLE worker
    write_env_line "$WORKER_ENV" AGENT_WORKER_PORT "$AGENT_WORKER_PORT"
    write_env_line "$WORKER_ENV" GITHUB_PAT "$GITHUB_PAT"
    write_env_line "$WORKER_ENV" GITHUB_REPOSITORY "${GITHUB_REPOSITORY:-}"

    case "$AGENT_GPU" in
        nv)
            if is_wsl; then
                write_env_line "$WORKER_ENV" LD_LIBRARY_PATH "$WSL_CUDA_LIB_DIR:/.singularity.d/libs"
            else
                write_env_line "$WORKER_ENV" LD_LIBRARY_PATH /.singularity.d/libs
            fi
            ;;
        rocm)
            write_env_line "$WORKER_ENV" LD_LIBRARY_PATH /opt/rocm/lib:/opt/rocm/lib64:/.singularity.d/libs
            ;;
    esac
    if [[ -n "$CA_BUNDLE" ]]; then
        write_env_line "$WORKER_ENV" SSL_CERT_FILE /etc/ssl/certs/ca-certificates.crt
        write_env_line "$WORKER_ENV" NODE_EXTRA_CA_CERTS /etc/ssl/certs/ca-certificates.crt
        write_env_line "$WORKER_ENV" REQUESTS_CA_BUNDLE /etc/ssl/certs/ca-certificates.crt
        write_env_line "$WORKER_ENV" GIT_SSL_CAINFO /etc/ssl/certs/ca-certificates.crt
        write_env_line "$WORKER_ENV" CURL_CA_BUNDLE /etc/ssl/certs/ca-certificates.crt
    fi
}

build_gateway_args() {
    local common=(exec --compat --cleanenv --no-mount "bind-paths,home,cwd,hostfs" --pwd /app)

    GATEWAY_ARGS=(
        "${common[@]}"
        --env-file "$GATEWAY_ENV"
        --bind "$STATE:/home/node/.openclaw:rw"
        --bind "$BOOTSTRAP:/gateway-workspace:ro"
        --bind "$GATEWAY_BRIDGE:/run/agent-bridge:ro"
        --bind "$RESOLV_CONF:/etc/resolv.conf:ro"
    )

    if [[ -n "$CA_BUNDLE" ]]; then
        GATEWAY_ARGS+=(--bind "$CA_BUNDLE:/etc/ssl/certs/ca-certificates.crt:ro")
    fi
}

build_worker_args() {
    local common=(exec --compat --cleanenv --no-mount "bind-paths,home,cwd,hostfs" --pwd /app)

    WORKER_ARGS=(
        "${common[@]}"
        --env-file "$WORKER_ENV"
        --bind "$WORKER_BRIDGE:/run/agent-bridge:ro"
        --bind "$WORKER_BRIDGE/home:$AGENT_LOGIN_HOME:ro"
        --bind "$WORKSPACE:/home/node/.openclaw/workspace:rw"
        --bind "$RESOLV_CONF:/etc/resolv.conf:ro"
    )

    case "$AGENT_GPU" in
        nv)
            WORKER_ARGS+=(--nv)
            if is_wsl; then
                command -v nvidia-container-cli >/dev/null 2>&1 ||
                    die 'nvidia-container-toolkit is required for NVIDIA GPU access under WSL'
                [[ -r "$WSL_CUDA_LIB_DIR/libcublasLt.so" ]] ||
                    die "WSL CUDA runtime libraries are missing from $WSL_CUDA_LIB_DIR"
                export NVIDIA_VISIBLE_DEVICES="${NVIDIA_VISIBLE_DEVICES:-all}"
                WORKER_ARGS+=(
                    --nvccli
                    --bind "$WSL_CUDA_LIB_DIR:$WSL_CUDA_LIB_DIR:ro"
                )
            fi
            ;;
        rocm) WORKER_ARGS+=(--rocm) ;;
    esac

    if [[ -n "$CA_BUNDLE" ]]; then
        WORKER_ARGS+=(--bind "$CA_BUNDLE:/etc/ssl/certs/ca-certificates.crt:ro")
    fi
}

prepare_gateway_command() {
    prepare
    write_gateway_env
    build_gateway_args
    ensure_gateway_plugin_links
}

prepare_commands() {
    prepare
    require_free_ports
    printf 'host-only\n' > "$HOST_SENTINEL"
    chmod 0600 "$HOST_SENTINEL"
    write_gateway_env
    write_worker_env
    build_gateway_args
    build_worker_args
    ensure_gateway_plugin_links
}

reset_runtime_logs() {
    : > "$LOG_DIR/worker.log"
    : > "$LOG_DIR/gateway.log"
    chmod 0600 "$LOG_DIR/worker.log" "$LOG_DIR/gateway.log"
}

gateway_cli() {
    apptainer "${GATEWAY_ARGS[@]}" "$IMAGE" \
        /usr/local/bin/agent-entrypoint openclaw "$@"
}

ensure_gateway_plugin_links() {
    local expected="v1|$IMAGE_VARIANT|$IMAGE_REF|slack=/opt/agent-plugins/slack"
    if [[ -s "$PLUGIN_LINK_STATE" && "$(<"$PLUGIN_LINK_STATE")" == "$expected" ]]; then
        return
    fi
    gateway_cli plugins install --link /opt/agent-plugins/slack
    printf '%s\n' "$expected" > "$PLUGIN_LINK_STATE"
    chmod 0600 "$PLUGIN_LINK_STATE"
}

start_worker() {
    apptainer "${WORKER_ARGS[@]}" "$IMAGE" \
        /usr/local/bin/agent-entrypoint worker \
        > >(tee "$LOG_DIR/worker.log") 2>&1 &
    WORKER_PID=$!
}

probe_worker() {
    apptainer "${GATEWAY_ARGS[@]}" "$IMAGE" \
        /usr/local/bin/agent-entrypoint probe-worker \
        "$AGENT_USER" "$AGENT_WORKER_PORT" "$HOST_SENTINEL" "$HOST_ENV_FILE" "$HOST_PRIVATE_FILE"
}

probe_worker_internet() {
    apptainer "${GATEWAY_ARGS[@]}" "$IMAGE" \
        /usr/local/bin/agent-entrypoint probe-worker-internet "$AGENT_USER" "$AGENT_WORKER_PORT"
}

probe_worker_long_command() {
    apptainer "${GATEWAY_ARGS[@]}" "$IMAGE" \
        /usr/local/bin/agent-entrypoint probe-worker-long-command "$AGENT_USER" "$AGENT_WORKER_PORT"
}

probe_worker_gpu() {
    [[ "$AGENT_GPU" != none ]] || return 0
    apptainer "${GATEWAY_ARGS[@]}" "$IMAGE" \
        /usr/local/bin/agent-entrypoint probe-worker-gpu \
        "$AGENT_USER" "$AGENT_WORKER_PORT" "$AGENT_GPU"
}

probe_worker_repository() {
    apptainer "${GATEWAY_ARGS[@]}" "$IMAGE" \
        /usr/local/bin/agent-entrypoint probe-worker-repository \
        "$AGENT_USER" "$AGENT_WORKER_PORT" "$GITHUB_REPOSITORY"
}

probe_gateway() {
    apptainer "${GATEWAY_ARGS[@]}" "$IMAGE" \
        /usr/local/bin/agent-entrypoint probe-gateway "$WORKSPACE"
}

wait_for_worker() {
    local attempt
    for ((attempt = 1; attempt <= 30; attempt++)); do
        if probe_worker >/dev/null 2>&1; then
            rm -f -- "$WORKER_ENV"
            WORKER_ENV=
            return 0
        fi
        kill -0 "$WORKER_PID" 2>/dev/null || die 'worker stopped during startup; inspect .agent/logs/worker.log'
        sleep 1
    done
    die 'worker readiness or isolation probe did not pass within 30 seconds'
}

clean_runtime_env() {
    [[ -n "$GATEWAY_ENV" ]] && rm -f -- "$GATEWAY_ENV"
    [[ -n "$WORKER_ENV" ]] && rm -f -- "$WORKER_ENV"
    rm -f -- "$HOST_SENTINEL"
    GATEWAY_ENV=
    WORKER_ENV=
}

stop_children() {
    local pid
    trap - EXIT INT TERM
    for pid in "$GATEWAY_PID" "$WORKER_PID"; do
        [[ -n "$pid" ]] || continue
        kill -TERM "$pid" 2>/dev/null || true
    done
    for pid in "$GATEWAY_PID" "$WORKER_PID"; do
        [[ -n "$pid" ]] || continue
        wait "$pid" 2>/dev/null || true
    done
    clean_runtime_env
}

auth_agent() {
    trap clean_runtime_env EXIT
    prepare_gateway_command
    gateway_cli config validate
    gateway_cli models auth login --provider openai --device-code
}

validate_agent() {
    local plugins
    trap stop_children EXIT INT TERM
    prepare_commands
    reset_runtime_logs

    gateway_cli config validate
    plugins="$(gateway_cli plugins list --enabled)"
    grep -qi openai <<<"$plugins" || die 'the OpenAI plugin is not enabled'
    grep -qi slack <<<"$plugins" || die 'the Slack plugin is not enabled'
    gateway_cli models status --check
    probe_gateway

    start_worker
    wait_for_worker
    probe_worker
    probe_worker_gpu
    probe_worker_long_command
    probe_worker_internet
    if [[ -n "${GITHUB_REPOSITORY:-}" ]]; then
        probe_worker_repository
    fi
    start_gateway
    wait_for_gateway
    clean_runtime_env
    printf 'Validation passed.\n'
}

start_gateway() {
    apptainer "${GATEWAY_ARGS[@]}" "$IMAGE" \
        /usr/local/bin/agent-entrypoint gateway \
        > >(tee "$LOG_DIR/gateway.log") 2>&1 &
    GATEWAY_PID=$!
}

wait_for_gateway() {
    local attempt status
    for ((attempt = 1; attempt <= 90; attempt++)); do
        status=
        if { exec 3<>"/dev/tcp/127.0.0.1/$AGENT_GATEWAY_PORT"; } 2>/dev/null; then
            printf 'GET /readyz HTTP/1.0\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n' >&3
            IFS= read -r status <&3 || true
            exec 3>&-
            exec 3<&-
        fi
        if [[ "$status" == *' 200 '* ]]; then
            rm -f -- "$GATEWAY_ENV"
            GATEWAY_ENV=
            return 0
        fi
        kill -0 "$GATEWAY_PID" 2>/dev/null ||
            die 'gateway stopped during startup; inspect .agent/logs/gateway.log'
        sleep 1
    done
    die 'gateway did not become ready within 90 seconds; inspect .agent/logs/gateway.log'
}

run_agent() {
    local finished status
    trap stop_children EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    prepare_commands
    reset_runtime_logs

    start_worker
    wait_for_worker
    probe_worker_gpu
    printf 'Worker ready on local port %s.\n' "$AGENT_WORKER_PORT"

    start_gateway
    wait_for_gateway
    printf 'Gateway running. Slack channel: %s\n' "$SLACK_CHANNEL_ID"

    set +e
    finished=
    wait -n -p finished "$WORKER_PID" "$GATEWAY_PID"
    status=$?
    set -e
    if [[ "$finished" == "$WORKER_PID" ]]; then
        printf 'ERROR: worker stopped while the gateway was running.\n' >&2
        return 1
    fi
    return "$status"
}

case "${1:-}" in
    pull)
        acquire_process_lock
        (($# <= 2)) || die 'pull accepts at most one variant or all'
        pull_image "${2:-}"
        ;;
    auth)
        acquire_process_lock
        auth_agent
        ;;
    validate)
        acquire_process_lock
        validate_agent
        ;;
    run)
        acquire_process_lock
        run_agent
        ;;
    -h|--help|help|'')
        usage
        ;;
    *)
        usage >&2
        die "unknown command: $1"
        ;;
esac
