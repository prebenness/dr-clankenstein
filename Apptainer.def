Bootstrap: docker
From: node:24-bookworm-slim

%post
    set -eux
    apt-get update
    apt-get install -y --no-install-recommends git curl ca-certificates tini
    rm -rf /var/lib/apt/lists/*
    mkdir -p /home/node/.npm-global
    chown -R node:node /home/node/.npm-global
    without_host_fakeroot() {
        env -u LD_PRELOAD -u FAKEROOTKEY -u FAKED_MODE -u FAKEROOT_FD "$@"
    }
    env | grep -E '^(LD_PRELOAD|FAKEROOT|FAKED)' || true
    without_host_fakeroot npm config set prefix /home/node/.npm-global -g
    without_host_fakeroot npm install -g \
        openclaw@latest \
        --prefix /home/node/.npm-global
    chown -R node:node /home/node/.npm-global
    without_host_fakeroot /home/node/.npm-global/bin/openclaw --version

%environment
    export PATH=/home/node/.npm-global/bin:$PATH
    export OPENCLAW_HIDE_BANNER=1
    export OPENCLAW_SKIP_GMAIL_WATCHER=1
    export OPENCLAW_SKIP_CANVAS_HOST=1
    export OPENCLAW_DISABLE_BONJOUR=1

%runscript
    exec /usr/bin/tini -- openclaw gateway "$@"
