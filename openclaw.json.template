{
  gateway: {
    mode: "local",
    port: __OPENCLAW_GATEWAY_PORT__,
    bind: "loopback",
    auth: {
      mode: "token",
      token: "${OPENCLAW_GATEWAY_TOKEN}",
    },
    controlUi: {
      enabled: false,
    },
  },

  agents: {
    defaults: {
      workspace: "/gateway-workspace",
      skipBootstrap: true,
      model: {
        primary: "openai/gpt-5.6-sol",
      },
      models: {
        "openai/gpt-5.6-sol": {
          agentRuntime: {
            id: "codex",
          },
          params: {
            fastMode: true,
          },
        },
      },
      promptOverlays: {
        gpt5: {
          personality: "off",
        },
      },
      thinkingDefault: "xhigh",
      timeoutSeconds: 1800,
      skills: [],
      sandbox: {
        mode: "all",
        backend: "ssh",
        scope: "agent",
        workspaceAccess: "rw",
        ssh: {
          target: "__AGENT_USER__@127.0.0.1:__AGENT_WORKER_PORT__",
          workspaceRoot: "/home/node/.openclaw/workspace",
          strictHostKeyChecking: true,
          updateHostKeys: false,
          identityFile: "/run/agent-bridge/client_key",
          knownHostsFile: "/run/agent-bridge/known_hosts",
        },
      },
      heartbeat: {
        every: "10m",
        session: "agent:main:slack:channel:__SLACK_CHANNEL_ID_LOWER__",
        target: "last",
        to: "__SLACK_CHANNEL_ID__",
        timeoutSeconds: 120,
        isolatedSession: false,
        lightContext: false,
        directPolicy: "allow",
        ackMaxChars: 0,
      },
    },
    list: [
      {
        id: "main",
        default: true,
        thinkingDefault: "xhigh",
        fastModeDefault: true,
      },
    ],
  },

  channels: {
    slack: {
      enabled: true,
      dmPolicy: "allowlist",
      allowFrom: ["__SLACK_ALLOWED_USER_ID__"],
      groupPolicy: "allowlist",
      channels: {
        "__SLACK_CHANNEL_ID__": {
          enabled: true,
          requireMention: false,
          users: ["__SLACK_ALLOWED_USER_ID__"],
        },
      },
      replyToMode: "off",
      historyLimit: 50,
      streaming: {
        mode: "off",
      },
    },
  },

  tools: {
    allow: [
      "exec",
      "process",
      "read",
      "write",
      "edit",
      "apply_patch",
      "web_search",
      "web_fetch",
      "message",
      "session_status",
    ],
    deny: ["browser", "canvas", "cron", "gateway", "nodes"],
    exec: {
      host: "sandbox",
      timeoutSec: 1800,
    },
    fs: {
      workspaceOnly: true,
    },
    elevated: {
      enabled: false,
    },
    web: {
      search: {
        enabled: true,
        openaiCodex: {
          enabled: true,
          mode: "cached",
        },
      },
      fetch: {
        enabled: true,
      },
    },
  },

  session: {
    scope: "per-sender",
    dmScope: "per-channel-peer",
    reset: {
      mode: "idle",
      idleMinutes: 1440,
    },
  },

  logging: {
    level: "info",
    redactSensitive: "tools",
    file: "/home/node/.openclaw/logs/openclaw.log",
  },

  update: {
    auto: { enabled: false },
    checkOnStart: false,
  },
  discovery: {
    mdns: { mode: "off" },
  },
  commands: {
    bash: false,
    config: false,
    restart: false,
  },
  plugins: {
    enabled: true,
    allow: ["slack", "openai", "codex", "memory-core"],
    load: {
      paths: ["/opt/openclaw-plugins/slack"],
    },
    entries: {
      openai: { enabled: true },
      slack: { enabled: true },
      codex: { enabled: true },
    },
    bundledDiscovery: "compat",
  },
}
