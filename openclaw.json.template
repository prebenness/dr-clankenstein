{
  gateway: {
    mode: "local",
    port: __OPENCLAW_GATEWAY_PORT__,
    bind: "loopback",
    auth: {
      mode: "token",
      token: "${OPENCLAW_GATEWAY_TOKEN}",
    },
    controlUi: {
      enabled: false,
    },
  },

  agents: {
    defaults: {
      workspace: "/home/node/.openclaw/workspace",
      model: {
        primary: "openai/gpt-5.5",
      },
      models: {
        "openai/gpt-5.5": {
          params: {
            fastMode: true,
          },
        },
      },
      thinkingDefault: "xhigh",
      sandbox: {
        mode: "off",
      },
      skills: [],
      heartbeat: {
        every: "10m",
        session: "agent:main:slack:channel:__SLACK_CHANNEL_ID_LOWER__",
        target: "last",
        to: "__SLACK_CHANNEL_ID__",
        timeoutSeconds: 120,
        isolatedSession: false,
        lightContext: false,
        directPolicy: "allow",
        ackMaxChars: 0,
      },
      timeoutSeconds: 1800,
    },
    list: [
      {
        id: "main",
        default: true,
        thinkingDefault: "xhigh",
        fastModeDefault: true,
      },
    ],
  },

  channels: {
    slack: {
      enabled: true,
      dmPolicy: "allowlist",
      allowFrom: [
        "__SLACK_ALLOWED_USER_ID__",
      ],
      channels: {
        "__SLACK_CHANNEL_ID__": {
          enabled: true,
          requireMention: false,
        },
      },
      replyToMode: "all",
      historyLimit: 500,
      thread: {
        historyScope: "channel",
        inheritParent: true,
        initialHistoryLimit: 100,
      },
      streaming: {
        mode: "partial",
      },
    },
  },

  tools: {
    allow: [
      "exec",
      "process",
      "read",
      "write",
      "edit",
      "apply_patch",
      "sessions_spawn",
      "sessions_send",
      "session_status",
      "subagents",
      "message",
    ],
    deny: ["browser", "canvas"],
    exec: {
      host: "gateway",
      timeoutSec: 1800,
    },
    web: {
      search: {
        enabled: true,
        openaiCodex: {
          enabled: true,
          mode: "cached",
        },
      },
      fetch: {
        enabled: true,
      },
    },
  },

  session: {
    scope: "per-sender",
    dmScope: "per-channel-peer",
    reset: {
      mode: "idle",
      idleMinutes: 1440,
    },
  },

  logging: {
    level: "debug",
    redactSensitive: "tools",
    file: "/home/node/.openclaw/logs/openclaw.log",
  },

  update: {
    auto: { enabled: false },
    checkOnStart: false,
  },

  discovery: {
    mdns: { mode: "off" },
  },

  commands: {
    bash: false,
    config: false,
    restart: false,
  },

  plugins: {
    enabled: true,
    allow: [
      "slack",
      "openai",
      "codex",
      "memory-core",
    ],
    entries: {
      openai: {
        enabled: true,
      },
      slack: {
        enabled: true,
      },
      codex: {
        enabled: true,
      },
    },
    bundledDiscovery: "compat",
  },

  messages: {
    groupChat: {
      visibleReplies: "message_tool",
    },
  },
}
