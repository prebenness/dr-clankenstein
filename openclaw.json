{
  gateway: {
    mode: "local",
    port: 18789,
    bind: "loopback",
    auth: {
      mode: "token",
      token: "${OPENCLAW_GATEWAY_TOKEN}",
    },
    controlUi: {
      enabled: false,
    },
  },

  agents: {
    defaults: {
      workspace: "/home/node/.openclaw/workspace",
      model: {
        primary: "openai-codex/gpt-5.5",
      },
      sandbox: {
        mode: "off",
      },
      skills: [],
      heartbeat: {
        every: "10m",
        session: "agent:main:slack:channel:c0b389bj4ma",
        target: "last",
        to: "C0B389BJ4MA",
        timeoutSeconds: 120,
        isolatedSession: false,
        lightContext: false,
        directPolicy: "allow",
        ackMaxChars: 0,
      },
      timeoutSeconds: 1800,
    },
    list: [
      { id: "main", default: true },
    ],
  },

  channels: {
    slack: {
      enabled: true,
      dmPolicy: "allowlist",
      allowFrom: [
        "U0B364S9A01",
      ],
      channels: {
        "C0B389BJ4MA": {
          enabled: true,
          requireMention: false,
        },
      },
      replyToMode: "all",
      historyLimit: 500,
      thread: {
        historyScope: "channel",
        inheritParent: true,
        initialHistoryLimit: 100,
      },
      streaming: {
        mode: "off",
      },
    },
  },

  tools: {
    allow: [
      "exec",
      "process",
      "read",
      "write",
      "edit",
      "apply_patch",
      "sessions_spawn",
      "sessions_send",
      "session_status",
      "subagents",
      "message",
    ],
    deny: ["browser", "canvas"],
    exec: {
      host: "gateway",
      timeoutSec: 1800,
    },
  },

  session: {
    scope: "per-sender",
    dmScope: "per-channel-peer",
    reset: {
      mode: "idle",
      idleMinutes: 1440,
    },
  },

  logging: {
    level: "debug",
    redactSensitive: "tools",
    file: "/home/node/.openclaw/logs/openclaw.log",
  },

  update: {
    auto: { enabled: false },
    checkOnStart: false,
  },

  discovery: {
    mdns: { mode: "off" },
  },

  commands: {
    bash: false,
    config: false,
    restart: false,
  },

  plugins: {
    enabled: true,
    allow: [],
  },
}
