ARG OPENCLAW_BASE_IMAGE=openclaw-base:local
ARG ROCM_BASE_IMAGE=docker.io/rocm/dev-ubuntu-22.04:6.2.4@sha256:030304ab0a88778b627b2eb2354c419146e105f5ac39ffd9c2438c82ef54b584

FROM ${ROCM_BASE_IMAGE} AS rocm-runtime
FROM ${OPENCLAW_BASE_IMAGE}

USER root

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        libdrm-amdgpu1 \
        libdrm2 \
        libelf1 \
        libnuma1 \
        zlib1g \
    && rm -rf /var/lib/apt/lists/*

COPY --from=rocm-runtime /opt/rocm /opt/rocm

ENV PATH="/opt/rocm/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/rocm/lib:/opt/rocm/lib64"

ARG ROCM_BASE_IMAGE
LABEL org.opencontainers.image.rocm.base="${ROCM_BASE_IMAGE}"

USER node
